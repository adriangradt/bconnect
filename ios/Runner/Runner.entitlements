<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed to send and receive UDP broadcasts for LAN discovery.
	     Apple grants it on request: https://developer.apple.com/contact/request/networking-multicast -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
